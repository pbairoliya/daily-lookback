<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pbairol.daily-lookback</string>

    <!-- __PROJECT_DIR__, __UV__, __HOME__ are substituted by scripts/install_launchd.sh -->
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>lookback.py</string>
        <string>--catch-up</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- PATH must include homebrew so the run can start/stop `ollama` itself. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <!-- Unbuffered stdout so the log files fill in real time. -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Midnight run, plus a 09:00 retry in case the Mac slept through it.
         --catch-up makes redundant fires free no-ops. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>0</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <!-- Fires on login/boot, so a powered-off night is backfilled on startup. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/lookback.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/lookback.err.log</string>
</dict>
</plist>
